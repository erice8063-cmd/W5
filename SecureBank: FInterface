package securebank;

import com.securebank.Transaction;

@FunctionalInterface

public interface TransactionRule {
    boolean test(Transaction transaction);

    default TransactionRule and(TransactionRule other) {
        return transaction -> this.test(transaction) && other.test(transaction);
    }
}

TransactionRule largeTransaction = transaction -> transaction.getAmount() >= 500.00
        TransactionRule isWithdrawal = transaction -> transactiongetType().equals("WITHDRAW");
TransactionRule largeWithdrawal = largeTransaction.and(isWithdrawal);
