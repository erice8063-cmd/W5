List<String> names = Arrays.asList("Alice", "Bob", "Charlie");
List<String> longNames = new ArrayList<>();

for (String name : names) {
    if (name.length() > 4) { // Only 'if', no 'else'
        longNames.add(name);
    }
}

//Stream//

List<String> longNames = names.stream()
    .filter(name -> name.length() > 4) // Replaces the 'if' condition
    .collect(Collectors.toList());    // Collects into a new list

List<Integer> numbers = Arrays.asList(1, 2, 3, 4);
List<String> results = new ArrayList<>();

for (Integer num : numbers) {
    if (num % 2 == 0) {
        results.add("Even");
    } else {
        results.add("Odd");
    }
}


//Stream//
List<String> results = numbers.stream()
    .map(num -> (num % 2 == 0) ? "Even" : "Odd") // Replaces if-else transformation
    .collect(Collectors.toList());
